# HamSafar — پیکربندی مستقل هر شرکت
# این فایل را برای هر شرکت کپی و مقدارها را تنظیم کنید.

# ─── هویت شرکت ───
COMPANY_NAME="شرکت نمونه سفر"
COMPANY_SLUG="demo-travel"
COMPANY_TAGLINE="سفرهای سازمانی و توریستی"
COMPANY_PHONE="021-12345678"
COMPANY_EMAIL="info@demo-travel.ir"
COMPANY_ADDRESS="تهران، خیابان ولیعصر، پلاک ۱"
# مبنای مالی همه قیمت‌ها (IRR = ریال ایران)
CURRENCY=IRR
# آدرس پایه عمومی سایت (برای sitemap و متا و درگاه پرداخت)
PUBLIC_BASE_URL=http://localhost:3000
# آدرس پایه API فدراسیون این نمونه (همان سرور)
FED_BASE_URL=http://localhost:3000

# ─── سرور ───
PORT=3000
HOST=127.0.0.1
# اگر سرور پشت پروکسی معکوس (nginx) است: PROXY_TRUSTED=127.0.0.1
PROXY_TRUSTED=
# کوکی امن در حالت https
COOKIE_SECURE=false
# فاصله نرم‌شوندگی درخواست‌های فدراسیون ورودی (میلی‌ثانیه، پیش‌فرض 5000)
FED_REQ_TIMEOUT_MS=5000
# اگر true باشد درخواست‌های فدراسیون در غیاب پروکسی معکوس هم پذیرفته می‌شوند
FED_INSECURE=1

# ─── امنیت ───
# کلید امضای کوکی نشست‌ها — در هر استقرار الزاماً تغییر دهید!
SESSION_SECRET=change-me-in-production
# شماره ساخت اسکیمای دیتابیس (دستی تغییر ندهید)
SCHEMA_VERSION=1
